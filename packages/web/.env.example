# Use "indexeddb" for local/offline browser storage or "api" for the REST backend.
VITE_STORAGE_PROVIDER=indexeddb

# Server origin only; ApiProvider appends /api/projects.
VITE_API_BASE_URL=http://localhost:3000

# With VITE_STORAGE_PROVIDER=api the app requires an account: AuthGate shows
# the login screen until /api/auth/me returns one.
