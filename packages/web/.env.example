# Account-backed API storage is the normal mode. Copy this file to .env.local
# for local development, then restart Vite.
VITE_STORAGE_PROVIDER=api

# Required in API mode. Server origin only; the client appends /api/...
VITE_API_BASE_URL=http://localhost:3000

# Offline browser-only storage must be selected explicitly:
# VITE_STORAGE_PROVIDER=indexeddb
# In offline mode there are no accounts and VITE_API_BASE_URL is ignored.
