# Copy to .env and fill in real values. Never commit the real .env file.

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Database (Milestone 3 — Postgres on Render) ---
# Neon pooled endpoint; retain the -pooler hostname and sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/rastoplan?sslmode=require
# Exact browser origin allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:5173

# --- Auth: per-user accounts. AUTH_SECRET signs the session cookie and must
# be at least 32 characters; the server refuses to boot without it. ---
AUTH_SECRET=change-me-to-at-least-32-characters-long

# --- Web (Vite exposes only VITE_-prefixed vars to client code) ---
# Storage provider used by the web app: "indexeddb" (default, offline-friendly)
# or "api" (talks to the server's /api/projects — wired up in Milestone 3).
VITE_STORAGE_PROVIDER=indexeddb
VITE_API_BASE_URL=http://localhost:3000
