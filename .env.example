# Copy to .env and fill in real values. Never commit the real .env file.

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Database (Milestone 3 — Postgres on Render) ---
DATABASE_URL=postgres://user:password@localhost:5432/rastoplan

# --- Auth (spec 12.3): one shared office password, no per-user accounts ---
OFFICE_PASSWORD=change-me
AUTH_SECRET=change-me-too

# --- Web (Vite exposes only VITE_-prefixed vars to client code) ---
# Storage provider used by the web app: "indexeddb" (default, offline-friendly)
# or "api" (talks to the server's /api/projects — wired up in Milestone 3).
VITE_STORAGE_PROVIDER=indexeddb
VITE_API_BASE_URL=http://localhost:3000
