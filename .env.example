# Server environment template. Supply these values through the process or the
# deployment platform; the server does not load this file automatically.
# Never commit real credentials.

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Database (Neon pooled Postgres) ---
# Neon pooled endpoint; retain the -pooler hostname and sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/rastoplan?sslmode=require
# Browser origins allowed to call the API with credentials, comma separated.
# vite dev serves on 5173 and vite preview on 4173, so local work needs both.
WEB_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Auth: per-user accounts. AUTH_SECRET signs the session cookie. Generate a
# unique random value of at least 32 characters; the example value is rejected. ---
AUTH_SECRET=change-me-to-at-least-32-characters-long

# Web/Vite variables belong in packages/web/.env.local. Start from
# packages/web/.env.example; API/account mode is the default and IndexedDB is
# available only when offline mode is selected explicitly.
